pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
--game manager
initial = true
game_over = false
timer = .5

t = 0
points = 0
hi_points = 0

function _init()
	start_game()	
end

function start_game()
	character = create()
	clouds = cloud_manager(rnd() * 15 + 5, rnd() * 5 + 1)
	obstacle = create_obstacle(2)
end

function _update()
	t += 1/30
	if game_over then 
		timer -= 1/30
		if timer < 0 then
			if btnp(⬆️) then
				_reset()
			end
		end
		return
	end
	character:_update()
	clouds:update()
	obstacle:update()
	
	if initial then 
		if btnp(⬆️) then
			initial = false
		end
	end
	
	if character.y < -10 or 
	character.y > 130 then
		game_over = true
		sfx(1)
	end 
	
	if obstacle:check_position(character.x,character.y) then
		game_over = true
		sfx(1,1,rnd() * 2 + 0.5)
	end
	
	if hi_points < points then
		hi_points = points
	end
end

function _draw()
	cls(0)
	if game_over then
		print ("game over",45,60)
		if timer < 0 then
			print("press ⬆️ to reset", 30,75)
		end
		return
	end
	cls(12)
	clouds:draw()
	character:_draw()
	obstacle:draw()
	
	if initial then 
		
		print("◆press ⬆️ to start◆",24,60,0)
		print("◆press ⬆️ to start◆",25,60,10)

		return 
	end
	
	print("points:", 3, 6, 0)
	print("points:", 4, 6, 10)
	print(points,31,6,0)
	print(points,32,6,10)

	
	print("hi:",3,12,0)
	print("hi:",4,12,10)
	print(hi_points,31,12,0)
	print(hi_points,32,12,10)
end

function _reset()
	character:_init()
	game_over = false
	timer = 0
	obstacle:reload()
	points = 0
end
-->8
--character
function create()
	local c = {}
	
	c._init = 
	function(self)
		self.x = 30
		self.y = 30
		self.anim = {1,2,1,3}
		self.cspr = 1
		self.t = 0
		self.y_move = 0
		self._t = 0
		self._pressed = false
	end
	
	c:_init()
			
	c._update =  
	function(self)
		self.t += 1 / 6
		i = flr(self.t % #self.anim) + 1
		self.cspr = self.anim[i]
		
		if initial then return end
		c.y_move -= 7/30
		if c.y_move < -10 then c.y_move = -10 end
		
		self:_input()
		
		self.y -= c.y_move
	end
	
	c._input = 
		function(self)
			if btn(⬆️) then
				
				if not self._pressed then
					self._t = 0
					self.y_move = 2
					sfx(0)
				end
			
				self._t += 1/3
				if(self._t) < 1 then
					self.y_move += .3
				end
			end
			self._pressed = btn(⬆️)
		end
	
	c._draw = 
		function(self)
			spr(self.cspr, self.x, self.y)
		end

	return c
end
-->8
--cloud manager

function cloud_manager(qtde, grandes)

	manager = {}
	manager.clouds = {}
	manager.bigclouds = {}
	for i = 0, qtde do
		manager.clouds[i] = cloud()
	end
	
	for i = 0, grandes do
		manager.bigclouds[i] = big_cloud()
	end
	
	manager.update = 
	function(self)
		for i = 0, #self.clouds do
			self.clouds[i]:update()
		end
		
		for i = 0, #self.bigclouds do
			self.bigclouds[i]:update()
		end
		
	end
	
	manager.draw = 
	function(self)
		for i = 0, #self.clouds do
			self.clouds[i]:draw()
		end
		for i = 0, #self.bigclouds do
			self.bigclouds[i]:draw()
		end
	end
	
	return manager
end

function cloud()
c = {}
c.x = rnd() * 250 + 130
c.y = rnd() * 130 + 20

c.update = 
	function(self)
		self.x -= 1
		if self.x < -8 then
			self:respawn()
		end
	end
	
c.draw = 
	function(self)
		spr(40,self.x,self.y)
	end
	
	c.respawn =
		function(self)
			self.x = 130
			self.y = rnd() * 130 + 20
		end
	
return c
end

function big_cloud()

c = {}
c.x = rnd() * 250 + 170
c.y = rnd() * 130 + 20

c.update = 
	function(self)
		self.x -= 1
		if self.x < -16 then
			self:respawn()
		end	
	end
	
c.draw = 
	function(self) 
		spr(41,self.x,self.y,2,2)
	end

c.respawn = 
	function(self)
		self.x = 150
		self.y = rnd() * 130 + 20
	end

return c

end
-->8
--obstacles

function create_obstacle(qtde)
local o = {}
o.objs = {}

for i = 0, qtde do
	o.objs[i] = obstacle(120 + 60 * i)
end


o.update = 
	function(self)
		if initial then return end
		for i = 0, #self.objs do
			self.objs[i]:update()
		end
	end
	
o.draw = 
	function(self)
		if initial then return end
		for i = 0,#self.objs do
			self.objs[i]:draw()
		end
	end
	
o.check_position = 
	function(self,x,y)
		retorno = false
		for i = 0, #self.objs do
			retorno = retorno or self.objs[i]:check_position(x,y)
			if  self.objs[i].started 
			and not self.objs[i]:is_started(x) 
			and self.objs[i].x < x 
			then
				--points
				points += 1
				self.objs[i].started = false
			end
		end
		return retorno
	end
	
o.reload = 
	function(self,x_pos)
		for i = 0, #self.objs do
			self.objs[i]:reload(120 + 60 * i)
		end
	end
	
return o
end

function obstacle(x_pos)
	local o = {}
	o.x = x_pos
	o.started = false
	
	o.position = flr(rnd() * 10 + 3)
	
	o.update = 
		function(self)
			self.x -= 1
			if self.x < -12 then
				self.x = 170
				self:respawn()
			end
		end

	o.draw = 
		function(self)
			for i = 0, 120 / 8 do
				if i < self.position - 1 or 
				i > self.position + 3 then
					spr(12,self.x, i * 8,2,1)
				end
				if i == self.position - 1 then
					spr(28,self.x, i * 8, 2, 1)
				end
				if i == self.position +3 then
					spr(44,self.x,i*8,2,1)
				end
			end
		end
				
		o.respawn = 
			function(self)
				self.position = flr(rnd() * 10 + 3)
			end
			
		o.reload = 
			function(self, x)
				self.x = x
				o.position = flr(rnd() * 10 + 3)			
				self.started = false
			end	
			
		o.is_started = 
			function(self,x)
				if x > self.x and x < self.x + 16 then
					self.started = true
					return true    
				end
				return false
			end
		
		o.check_position = 
		function(self,x,y)
			if self:is_started(x)then
				if y < self.position  * 8 - 4then
					return true	
				end
				if y > (self.position  + 3) * 8 + 4 then
					return true
				end
			end
		end
		
	return o
end


